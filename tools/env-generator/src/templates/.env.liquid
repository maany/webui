[public]
{% assign enable_ssl = context['ENABLE_SSL'] | downcase %}
{% if enable_ssl == 'true' %}
NEXT_PUBLIC_WEBUI_HOST=https://{{ context["HOSTNAME"] }}
{% else %}
NEXT_PUBLIC_WEBUI_HOST=http://{{ context["HOSTNAME"] }}
{% endif %}
PROJECT_URL={{ context.PROJECT_URL }}

[login]
ENABLE_USERPASS_LOGIN={{ context.ENABLE_USERPASS_LOGIN }}
X509_ENABLED={{ context.X509_ENABLED }}

[rules]
RULE_ACTIVITY={{ context.RULE_ACTIVITY | json }}

[auth]
AUTH_SECRET={{ context.AUTH_SECRET }}
NEXTAUTH_SECRET={{ context.NEXTAUTH_SECRET }}
AUTH_TRUST_HOST={{ context.AUTH_TRUST_HOST }}
NEXTAUTH_URL={{ context.NEXTAUTH_URL }}

[fetch]
NODE_TLS_REJECT_UNAUTHORIZED={{ context.NODE_TLS_REJECT_UNAUTHORIZED }}
{% if enable_ssl == 'true' %}
NODE_EXTRA_CA_CERTS={{ context.SERVER_CA_BUNDLE }}
{% endif %}

[gateway]
RUCIO_AUTH_HOST={{ context.RUCIO_AUTH_HOST }}
RUCIO_HOST={{ context.RUCIO_HOST }}
PARAMS_ENCODING_ENABLED={{ context.PARAMS_ENCODING_ENABLED }}
LIST_DIDS_INITIAL_PATTERN={{ context.LIST_DIDS_INITIAL_PATTERN }}

[features]
FEATURE_DDM_DASHBOARD={{ context.FEATURE_DDM_DASHBOARD }}
{% if context.DDM_DASHBOARD_BASE_URL %}DDM_DASHBOARD_BASE_URL={{ context.DDM_DASHBOARD_BASE_URL }}{% endif %}
FEATURE_RULES={{ context.FEATURE_RULES }}
FEATURE_RULES_CREATE={{ context.FEATURE_RULES_CREATE }}
FEATURE_RULES_APPROVE={{ context.FEATURE_RULES_APPROVE }}
FEATURE_SUBSCRIPTIONS={{ context.FEATURE_SUBSCRIPTIONS }}
FEATURE_RSES={{ context.FEATURE_RSES }}
FEATURE_ACCOUNTS={{ context.FEATURE_ACCOUNTS }}
FEATURE_ACCOUNTS_MANAGE={{ context.FEATURE_ACCOUNTS_MANAGE }}
FEATURE_ACCOUNTS_MANAGE_CORE={{ context.FEATURE_ACCOUNTS_MANAGE_CORE }}
FEATURE_ACCOUNTS_MANAGE_IDENTITIES={{ context.FEATURE_ACCOUNTS_MANAGE_IDENTITIES }}
FEATURE_ACCOUNTS_MANAGE_ATTRIBUTES={{ context.FEATURE_ACCOUNTS_MANAGE_ATTRIBUTES }}
FEATURE_ACCOUNTS_MANAGE_QUOTAS={{ context.FEATURE_ACCOUNTS_MANAGE_QUOTAS }}
FEATURE_DIDS_METADATA={{ context.FEATURE_DIDS_METADATA }}
FEATURE_DIDS_MUTATE={{ context.FEATURE_DIDS_MUTATE }}
FEATURE_REQUESTS={{ context.FEATURE_REQUESTS }}
FEATURE_DIDS_AMI_TAGS={{ context.FEATURE_DIDS_AMI_TAGS }}
{% if context.AMI_BASE_URL %}AMI_BASE_URL={{ context.AMI_BASE_URL }}{% endif %}
FEATURE_DIDS_PANDA_TASK={{ context.FEATURE_DIDS_PANDA_TASK }}
{% if context.PANDA_BASE_URL %}PANDA_BASE_URL={{ context.PANDA_BASE_URL }}{% endif %}
FEATURE_ASSISTANT={{ context.FEATURE_ASSISTANT }}
FEATURE_ASSISTANT_WRITE={{ context.FEATURE_ASSISTANT_WRITE }}
FEATURE_ASSISTANT_BAD_REPLICAS={{ context.FEATURE_ASSISTANT_BAD_REPLICAS }}

[assistant]
{% if context.ASSISTANT_WRITE_POLICY_CAP %}ASSISTANT_WRITE_POLICY_CAP={{ context.ASSISTANT_WRITE_POLICY_CAP }}{% endif %}
{% if context.ASSISTANT_HIGH_RISK_POLICY_CAP %}ASSISTANT_HIGH_RISK_POLICY_CAP={{ context.ASSISTANT_HIGH_RISK_POLICY_CAP }}{% endif %}
{% if context.ASSISTANT_ALLOW_BYOK %}ASSISTANT_ALLOW_BYOK={{ context.ASSISTANT_ALLOW_BYOK }}{% endif %}
{% if context.ASSISTANT_ALLOWED_PROVIDER_KINDS %}ASSISTANT_ALLOWED_PROVIDER_KINDS={{ context.ASSISTANT_ALLOWED_PROVIDER_KINDS }}{% endif %}
{% if context.ASSISTANT_DEFAULT_PROVIDER_KIND %}ASSISTANT_DEFAULT_PROVIDER_KIND={{ context.ASSISTANT_DEFAULT_PROVIDER_KIND }}{% endif %}
{% if context.ASSISTANT_DEFAULT_BASE_URL %}ASSISTANT_DEFAULT_BASE_URL={{ context.ASSISTANT_DEFAULT_BASE_URL }}{% endif %}
{% if context.ASSISTANT_DEFAULT_API_KEY %}ASSISTANT_DEFAULT_API_KEY={{ context.ASSISTANT_DEFAULT_API_KEY }}{% endif %}
{% if context.ASSISTANT_DEFAULT_MODEL %}ASSISTANT_DEFAULT_MODEL={{ context.ASSISTANT_DEFAULT_MODEL }}{% endif %}
{% if context.ASSISTANT_DEFAULT_MODEL_LABEL %}ASSISTANT_DEFAULT_MODEL_LABEL={{ context.ASSISTANT_DEFAULT_MODEL_LABEL | json }}{% endif %}
{% if context.ASSISTANT_DEFAULT_CONTEXT_WINDOW %}ASSISTANT_DEFAULT_CONTEXT_WINDOW={{ context.ASSISTANT_DEFAULT_CONTEXT_WINDOW }}{% endif %}
{% if context.ASSISTANT_SKILLS_DIR %}ASSISTANT_SKILLS_DIR={{ context.ASSISTANT_SKILLS_DIR }}{% endif %}
{% if context.ASSISTANT_TELEMETRY_OTLP_ENDPOINT %}ASSISTANT_TELEMETRY_OTLP_ENDPOINT={{ context.ASSISTANT_TELEMETRY_OTLP_ENDPOINT }}{% endif %}
{% if context.ASSISTANT_TELEMETRY_OTLP_HEADERS %}ASSISTANT_TELEMETRY_OTLP_HEADERS={{ context.ASSISTANT_TELEMETRY_OTLP_HEADERS | json }}{% endif %}
{% if context.ASSISTANT_TELEMETRY_ALLOW_USER_SINKS %}ASSISTANT_TELEMETRY_ALLOW_USER_SINKS={{ context.ASSISTANT_TELEMETRY_ALLOW_USER_SINKS }}{% endif %}
{% if context.ASSISTANT_TELEMETRY_CONTENT_CAP %}ASSISTANT_TELEMETRY_CONTENT_CAP={{ context.ASSISTANT_TELEMETRY_CONTENT_CAP }}{% endif %}
{% if context.ASSISTANT_TELEMETRY_HASH_USER %}ASSISTANT_TELEMETRY_HASH_USER={{ context.ASSISTANT_TELEMETRY_HASH_USER }}{% endif %}
{% if context.ASSISTANT_TELEMETRY_USER_SALT %}ASSISTANT_TELEMETRY_USER_SALT={{ context.ASSISTANT_TELEMETRY_USER_SALT | json }}{% endif %}
{% if context.ASSISTANT_PRICES_JSON %}ASSISTANT_PRICES_JSON={{ context.ASSISTANT_PRICES_JSON | json }}{% endif %}
{% if context.ASSISTANT_RELAY_RATE_LIMIT %}ASSISTANT_RELAY_RATE_LIMIT={{ context.ASSISTANT_RELAY_RATE_LIMIT }}{% endif %}

[oidc]
OIDC_ENABLED={{ context.OIDC_ENABLED }}
{% if context.OIDC_EXPECTED_AUDIENCE_CLAIM %}
OIDC_EXPECTED_AUDIENCE_CLAIM={{ context.OIDC_EXPECTED_AUDIENCE_CLAIM }}
{% endif %}
{% if context.OIDC_PROVIDERS %}
OIDC_PROVIDERS={{ context.OIDC_PROVIDERS }}
{% assign oidc_providers = context.OIDC_PROVIDERS | split: "," | strip %}
{% for provider in oidc_providers %}
    {% assign providerName = provider | upcase | strip %}
    {% assign client_id  = 'OIDC_PROVIDER_' | append: providerName | append: "_CLIENT_ID" %}
    {% assign client_secret  = 'OIDC_PROVIDER_' | append: providerName | append: "_CLIENT_SECRET" %}
    {% assign authorization_url = "OIDC_PROVIDER_" | append: providerName | append: "_AUTHORIZATION_URL" %}
    {% assign token_url = "OIDC_PROVIDER_" | append: providerName | append: "_TOKEN_URL" %}
    {% assign redirect_url = "OIDC_PROVIDER_" | append: providerName | append: "_REDIRECT_URL" %}
    {% assign userinfo_url = "OIDC_PROVIDER_" | append: providerName | append: "_USERINFO_URL" %}
    {% assign refresh_token_url = "OIDC_PROVIDER_" | append: providerName | append: "_REFRESH_TOKEN_URL" %}
    {% assign scopes = "OIDC_PROVIDER_" | append: providerName | append: "_SCOPES" %}
    {% assign issuer = "OIDC_PROVIDER_" | append: providerName | append: "_ISSUER" %}
    {% assign icon_url = "OIDC_PROVIDER_" | append: providerName | append: "_ICON_URL" %}
    {% assign logout_url = "OIDC_PROVIDER_" | append: providerName | append: "_LOGOUT_URL" %}
{% if context[client_id] %}
OIDC_PROVIDER_{{ provider | upcase | strip }}_CLIENT_ID={{ context[client_id]}}
{% endif %}
{% if context[client_secret] %}
OIDC_PROVIDER_{{ provider | upcase | strip }}_CLIENT_SECRET={{ context[client_secret]}}
{% endif %}
{% if context[authorization_url] %}
OIDC_PROVIDER_{{ provider | upcase | strip }}_AUTHORIZATION_URL={{ context[authorization_url]}}
{% endif %}
{% if context[token_url] %}
OIDC_PROVIDER_{{ provider | upcase | strip }}_TOKEN_URL={{ context[token_url]}}
{% endif %}
{% if context[redirect_url] %}
OIDC_PROVIDER_{{ provider | upcase | strip }}_REDIRECT_URL={{ context[redirect_url]}}
{% endif %}
{% if context[userinfo_url] %}
OIDC_PROVIDER_{{ provider | upcase | strip }}_USERINFO_URL={{ context[userinfo_url]}}
{% endif %}
{% if context[refresh_token_url] %}
OIDC_PROVIDER_{{ provider | upcase | strip }}_REFRESH_TOKEN_URL={{ context[refresh_token_url]}}
{% endif %}
{% if context[scopes] %}
OIDC_PROVIDER_{{ provider | upcase | strip }}_SCOPES={{ context[scopes]}}
{% endif %}
{% if context[issuer] %}
OIDC_PROVIDER_{{ provider | upcase | strip }}_ISSUER={{ context[issuer]}}
{% endif %}
{% if context[icon_url] %}
OIDC_PROVIDER_{{ provider | upcase | strip }}_ICON_URL={{ context[icon_url]}}
{% endif %}
{% if context[logout_url] %}
OIDC_PROVIDER_{{ provider | upcase | strip }}_LOGOUT_URL={{ context[logout_url]}}
{% endif %}
{% endfor %}
{% endif %}

[multi_vo]
MULTIVO_ENABLED={{ context.MULTIVO_ENABLED }}
VO_DEFAULT={{ context.VO_DEFAULT }}
VO_LIST={{ context.VO_LIST }}
{% assign vos = context.VO_LIST | split: "," %}
{% for vo in vos%}
    {% assign voName = vo | upcase | strip %}
    {% assign name = 'VO_' | append: voName | append: "_NAME" %}
    {% assign logo = 'VO_' | append: voName | append: "_LOGO" %}
    {% assign oidc_enabled = 'VO_' | append: voName | append: "_OIDC_ENABLED" %}
    {% assign oidc_providers = 'VO_' | append: voName | append: "_OIDC_PROVIDERS" %}
{% if context[name] %}
VO_{{ vo | upcase | strip }}_NAME={{ context[name] }}
{% endif %}
{% if context[logo] %}
VO_{{ vo | upcase | strip }}_LOGO={{ context[logo] }}
{% endif %}
{% if context[oidc_enabled] %}
VO_{{ vo | upcase | strip }}_OIDC_ENABLED={{ context[oidc_enabled] }}
{% endif %}
{% if context[oidc_providers] %}
VO_{{ vo | upcase | strip }}_OIDC_PROVIDERS={{ context[oidc_providers] }}
{% endif %}

{% endfor %}
