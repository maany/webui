{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["es2023"],
        "module": "preserve",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "types": ["node"],
        "baseUrl": "../..",
        "paths": { "@/*": ["./src/*"] }
    },
    "include": ["./*.ts"]
}
